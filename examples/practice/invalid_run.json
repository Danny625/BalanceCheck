ected_skill_groups\": [\"High\"],\n      \"action\": \"Investigate\",\n      \"metric_refs\": [\"stats:3.2:Brannoc:High\"],\n      \"comment_ids\": [],\n      \"context_refs\": [\"patch:3.2\"],\n      \"rationale\": \"Brannoc shows a strong positive win rate flag specifically within the High skill group, while remaining within expected ranges in other tiers.\",\n      \"uncertainty\": \"High-tier specific overperformance may stem from specialized execution of certain abilities by skilled players.\",\n      \"next_step\": \"Analyze high-MMR match recordings and ability usage patterns for Brannoc.\"\n    }\n  ],\n  \"review_notes\": [\n    \"Quill appearances are below the minimum threshold required for a balance call, necessitating data collection rather than balance action.\",\n    \"No outdated or suspicious comments were factored into these priorities.\"\n  ]\n}"
